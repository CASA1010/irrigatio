[{"id":"a2749ef0aa6beef9","type":"tab","label":"Irrigation Project","disabled":false,"info":"","env":[]},{"id":"e7cda51d0c0ab185","type":"change","z":"a2749ef0aa6beef9","name":"set msg._ui","rules":[{"t":"set","p":"_ui","pt":"msg","to":"(\t  [\t    {\t      \"method\":\"update\",\t      \"components\":[\t        {\t          \"id\": _ui.id,\t          \"attributes\":{\t            /* Toggle fill colour */\t            /*\"class\":\"bulb \" & payload.posn & \" \" & (payload.state = \"off\" ? \"bulb-warn\" : \"\"),*/\t            \"class\":\"selected_tile\"\t          }\t        }\t      ]\t    }\t]\t)","tot":"jsonata"}],"action":"","property":"","from":"","to":"","reg":false,"x":810,"y":680,"wires":[["586826ecf8b6706b"]]},{"id":"ebf632c26a8ffb0c","type":"uib-element","z":"a2749ef0aa6beef9","name":"SVG and Table","topic":"tiles","elementtype":"html","parent":"#more","parentSource":"","parentSourceType":"str","elementid":"svg_with_tiles","elementId":"","elementIdSourceType":"str","heading":"","headingSourceType":"str","headingLevel":"h2","data":"payload","dataSourceType":"msg","position":"last","positionSourceType":"str","passthrough":false,"confData":{},"x":720,"y":300,"wires":[["586826ecf8b6706b"]]},{"id":"93d255e0ca2b9de2","type":"inject","z":"a2749ef0aa6beef9","name":"manuell","props":[{"p":"topic","vt":"str"},{"p":"payload"}],"repeat":"","crontab":"","once":false,"onceDelay":0.1,"topic":"","payload":"","payloadType":"date","x":110,"y":140,"wires":[["9c9da024b1068921"]]},{"id":"62e6638c745a0e58","type":"template","z":"a2749ef0aa6beef9","name":"","field":"payload","fieldType":"msg","format":"handlebars","syntax":"mustache","template":"<!-- Container für SVG und Tabelle nebeneinander -->\n\n<div style=\"display: flex; flex-direction: row; gap: 20px; height: 700px;\">  \n\n  <!-- Linke Seite: SVG-Plan -->\n\n  <div style=\"flex: 1; border: 1px solid #ccc; padding: 10px; overflow: scroll;\n    box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);\">\n\n\n      <!-- SVG -->\n   \n<svg width=\"200mm\" height=\"300mm\" viewBox=\"0 0 841 1189\" version=\"1.1\" id=\"svg1\" xml:space=\"preserve\"\n    inkscape:version=\"1.4 (86a8ad7, 2024-10-11)\" sodipodi:docname=\"floorplan mit Bäumen ohne Original.svg\"\n    inkscape:export-filename=\"floorplan mit Bäumen ohne Original.svg\" inkscape:export-xdpi=\"96\"\n    inkscape:export-ydpi=\"96\" xmlns:inkscape=\"http://www.inkscape.org/namespaces/inkscape\"\n    xmlns:sodipodi=\"http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd\" xmlns:xlink=\"http://www.w3.org/1999/xlink\"\n    xmlns=\"http://www.w3.org/2000/svg\" xmlns:svg=\"http://www.w3.org/2000/svg\">\n    <sodipodi:namedview id=\"namedview1\" pagecolor=\"#ffffff\" bordercolor=\"#000000\" borderopacity=\"0.25\"\n        inkscape:showpageshadow=\"2\" inkscape:pageopacity=\"0.0\" inkscape:pagecheckerboard=\"0\"\n        inkscape:deskcolor=\"#d1d1d1\" inkscape:document-units=\"mm\" showgrid=\"false\" inkscape:zoom=\"0.18375\"\n        inkscape:cx=\"2563.2654\" inkscape:cy=\"1072.1089\" inkscape:window-width=\"2100\" inkscape:window-height=\"1224\"\n        inkscape:window-x=\"-9\" inkscape:window-y=\"-9\" inkscape:window-maximized=\"1\" inkscape:current-layer=\"layer3\"\n        showguides=\"true\" />\n    <defs id=\"defs1\">\n        <linearGradient id=\"linearGradient7\" inkscape:collect=\"always\">\n            <stop style=\"stop-color:#0feb7d;stop-opacity:1;\" offset=\"0\" id=\"stop8\" />\n            <stop style=\"stop-color:#4f8a1d;stop-opacity:0;\" offset=\"1\" id=\"stop9\" />\n        </linearGradient>\n        <linearGradient id=\"linearGradient6\" inkscape:collect=\"always\">\n            <stop style=\"stop-color:#336010;stop-opacity:1;\" offset=\"0.01029159\" id=\"stop6\" />\n            <stop style=\"stop-color:#77de1f;stop-opacity:0;\" offset=\"1\" id=\"stop7\" />\n        </linearGradient>\n        <radialGradient inkscape:collect=\"always\" xlink:href=\"#linearGradient6\" id=\"radialGradient7\" cx=\"684.58445\"\n            cy=\"320.6137\" fx=\"684.58445\" fy=\"320.6137\" r=\"48.457138\"\n            gradientTransform=\"matrix(1,0,0,0.91524047,0,27.175065)\" gradientUnits=\"userSpaceOnUse\" />\n        <radialGradient inkscape:collect=\"always\" xlink:href=\"#linearGradient7\" id=\"radialGradient9\" cx=\"619.93947\"\n            cy=\"291.53208\" fx=\"619.93947\" fy=\"291.53208\" r=\"44.931715\"\n            gradientTransform=\"matrix(1,0,0,0.91756146,0,24.033479)\" gradientUnits=\"userSpaceOnUse\" />\n\n<radialGradient id=\"radialGradient_left1\" cx=\"380\" cy=\"180\" r=\"45\" gradientUnits=\"userSpaceOnUse\">\n  <stop offset=\"0\" style=\"stop-color:#0feb7d;stop-opacity:1\"/>\n  <stop offset=\"1\" style=\"stop-color:#4f8a1d;stop-opacity:0\"/>\n</radialGradient>\n\n<radialGradient id=\"radialGradient_left2\" cx=\"420\" cy=\"200\" r=\"40\" gradientUnits=\"userSpaceOnUse\">\n  <stop offset=\"0\" style=\"stop-color:#336010;stop-opacity:1\"/>\n  <stop offset=\"1\" style=\"stop-color:#77de1f;stop-opacity:0\"/>\n</radialGradient>\n\n\n    </defs>\n    <g inkscape:groupmode=\"layer\" id=\"layer2\" inkscape:label=\"Umrisse\" style=\"display:inline\">\n        <path\n            style=\"display:inline;fill:none;stroke:#000000;stroke-width:1.32292;stroke-dasharray:none;stroke-opacity:1\"\n            d=\"M 732.30486,305.50176 385.28671,168.71037 71.386474,856.26708 372.6875,973.61969 l 348.81804,7.9195 z\"\n            id=\"path1\" inkscape:label=\"Grundstücks-Umriss\" />\n        <path\n            style=\"display:inline;fill:none;stroke:#000000;stroke-width:1.32292;stroke-dasharray:none;stroke-opacity:1\"\n            d=\"m 670.27779,415.41385 -326.85942,-4.31972 -4.67969,145.43082 h 25.55838 l -4.31972,138.23129 55.43651,0.35999 -2.51984,62.99603 249.82426,5.0397 z\"\n            id=\"path2\" inkscape:label=\"Umriss Haus\" />\n    </g>\n    <g inkscape:groupmode=\"layer\" id=\"layer3\" inkscape:label=\"Bewässerungs-Kacheln\" inkscape:highlight-color=\"#35f339\"\n        style=\"display:inline\">\n{{#payload}}\n<rect style=\"stroke:#000000;stroke-width:1.32292;stroke-dasharray:none;stroke-opacity:1\" id=\"tile{{id}}\"\n            {{#is_humid}}\n            class=\"humid_tile\"\n            {{/is_humid}}\n            {{^is_humid}}\n            class=\"dry_tile\"\n            {{/is_humid}}\n            width=\"50\" height=\"50\" x=\"{{x}}\" y=\"{{y}}\" inkscape:label=\"Bewässerungs-Kachel 9\"\n            rx=\"2\" inkscape:highlight-color=\"#35f339\" ry=\"2\" onclick=\"handleTileClick({{id}})\"/>\n{{/payload}}\n    </g>\n    <g inkscape:groupmode=\"layer\" id=\"layer5\" inkscape:label=\"Deko-Objekte\">\n        <path style=\"fill:url(#radialGradient7);stroke:#4c9017;stroke-width:1.32292;stroke-opacity:1\"\n            d=\"m 713.22784,284.32387 -12.98168,-1.78179 -10.94531,-4.83632 -8.14535,-0.76361 -8.59748,5.00795 -7.94779,7.71917 -12.72712,3.30904 -9.67261,9.92716 -1.01817,7.12719 1.78181,5.85446 -2.54543,3.05451 2.03634,2.03634 -5.59993,11.19987 5.34538,10.94533 -0.50909,9.41806 9.41808,5.3454 7.38173,-1.01817 9.41807,2.54542 6.10902,4.8363 12.72712,-2.79996 1.2727,-3.0545 14.76346,-2.2909 9.16352,-3.81812 11.70895,-18.58161 -1.52725,-6.36355 10.08626,-16.72 -7.0943,-7.94853 -6.55556,-12.74921 z\"\n            id=\"path5\" sodipodi:nodetypes=\"ccccccccccccccccccccccccccccc\" />\n        <path style=\"fill:url(#radialGradient9);stroke:#077a41;stroke-width:1.32292;stroke-opacity:1;fill-opacity:1\"\n            d=\"m 628.71976,250.97882 -8.8388,4.78507 -5.84311,3.1181 -3.91845,-1.54463 -3.12018,-1.22994 -15.01651,5.23612 -2.69983,7.73951 -10.25935,11.87926 -0.71996,6.29959 -2.15985,2.33987 2.69984,1.61989 -0.71996,6.11963 -1.61991,3.95972 -0.71996,2.69984 4.85971,2.51984 1.25992,2.15987 0.71995,4.31972 1.07993,6.47959 3.41979,3.95976 4.31972,2.87983 5.57964,0.71996 7.01958,4.49971 4.13972,0.53996 2.33987,-1.07995 5.75964,0.89996 7.73951,-1.43992 7.19955,-3.0598 6.60725,2.85366 6.17194,-3.39362 3.0598,-1.79988 5.21967,-5.75964 3.0598,-8.2795 3.0598,-5.75963 5.75967,-10.07936 -3.05983,-10.61934 1.0859,-6.70121 -2.18225,-0.86021 -1.0635,-9.35749 -4.31974,-3.77978 -8.63944,-3.23979 -5.39967,-5.75964 -5.75964,-3.41979 z\"\n            id=\"path7\" />\n\n  <!-- Árbol nuevo 1 en la parte superior izquierda -->\n<path style=\"fill:url(#radialGradient_left1);stroke:#4c9017;stroke-width:1.32292;\n             stroke-opacity:0.5;fill-opacity:0.8\"\n      d=\"m 380,180 -12,-2 -10,-5 -8,-1 -9,5 -8,8 -13,3 -10,10 -1,7 2,6 -3,3 2,2 -6,11 5,11 -1,9 9,5 7,-1 9,3 6,5 13,-3 1,-3 15,-2 9,-4 12,-19 -2,-6 10,-17 -7,-8 -7,-13 z\"\n      id=\"path_new_left1\" />\n\n<!-- Árbol nuevo 2 en la parte superior izquierda -->\n<path style=\"fill:url(#radialGradient_left2);stroke:#077a41;stroke-width:1.32292;\n             stroke-opacity:0.5;fill-opacity:0.8\"\n      d=\"m 420,200 -9,5 -6,3 -4,-2 -3,-1 -15,5 -3,8 -10,12 -1,6 -2,2 3,2 -1,6 -2,4 -1,3 5,3 1,2 1,4 1,6 3,4 4,3 6,1 7,5 4,1 2,-1 6,1 8,-1 7,-3 7,3 6,-3 3,-2 5,-6 3,-8 3,-6 6,-10 -3,-11 1,-7 -2,-1 -1,-9 -4,-4 -9,-3 -5,-6 -6,-3 z\"\n      id=\"path_new_left2\" />\n\n    </g>\n</svg> \n </div>\n\n\n<!-- Rechte Seite: Tabelle -->\n<div style=\"flex: 1; border: 1px solid #ccc; padding: 10px; overflow-y: auto;\n    box-shadow: 0 4px 8px rgba(0, 123, 255, 0.3);\">\n\n  <table id=\"example\" class=\"table table-striped\" style=\"width:100%\">\n    <thead>\n      <tr>\n        <th><input type=\"checkbox\" id=\"select-all\" onclick=\"toggleAll(this)\"></th>\n        <th>Id</th>\n        <th>ModBus-Adresse</th>\n        <th>X-Position</th>\n        <th>Y-Position</th>\n        <th>Feuchtigkeit</th>\n        <th>Bewässerung aktiv</th>\n      </tr>\n    </thead>\n    <tbody id=\"table-body\">\n      {{#payload}}\n      <tr>\n        <!--<td><input type=\"checkbox\" class=\"row-checkbox\" onclick=\"fillFormFromRow(this)\"></td> -->\n         <td><input type=\"checkbox\" class=\"row-checkbox\" onclick=\"handleSingleCheckboxSelection(this); fillFormFromRow(this);\"></td>\n        <td>{{id}}</td>\n        <td>{{modBusId}}</td>\n        <td>{{x}}</td>\n        <td>{{y}}</td>\n        <td>{{humidity}}</td>\n        <td>{{watering}}</td>\n      </tr>\n      {{/payload}}\n    </tbody>\n  </table>\n\n  <!-- Botones alineados a la derecha debajo de la tabla -->\n  <div style=\"display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;\">\n    <button onclick=\"prepareFormForInsert()\" style=\"\n      padding: 6px 12px;\n      font-size: 14px;\n      background-color: #007bff;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    \">\n      Zeile hinzufügen\n    </button>\n\n     <button onclick=\"prepareFormForEdit()\" style=\"\n    padding: 6px 12px;\n    font-size: 14px;\n    background-color: #ffc107;\n    color: black;\n    border: none;\n    border-radius: 4px;\n    cursor: pointer;\n  \">\n    Zeile bearbeiten\n  </button>\n\n    <button onclick=\"deleteSelectedRow()\" style=\"\n      padding: 6px 12px;\n      font-size: 14px;\n      background-color: #dc3545;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    \">\n      Zeile löschen\n    </button>\n  </div>\n</div>\n\n\n\n<!-- Formularbereich -->\n<div id=\"form-container\" style=\"display:none; margin-top: 20px; border: 1px solid #ccc; padding: 10px;\">\n  <h4>Zeilenformular</h4>\n  <label>Id: <input type=\"text\" id=\"form-id\" disabled></label><br>\n  <label>ModBus-Adresse: <input type=\"text\" id=\"form-modbus\"></label><br>\n  <label>X-Position: <input type=\"number\" id=\"form-x\" disabled></label><br>\n  <label>Y-Position: <input type=\"number\" id=\"form-y\" disabled></label><br>\n  <label>Feuchtigkeit: <input type=\"number\" id=\"form-humidity\" disabled></label><br><br>\n  <label>Bewässerung aktiv: \n    <select id=\"form-watering\">\n      <option value=\"Ja\">Ja</option>\n      <option value=\"Nein\">Nein</option>\n    </select>\n  </label><br><br>\n\n\n  <button onclick=\"submitForm()\" style=\"\n  padding: 4px 10px;\n  font-size: 13px;\n  background-color: #28a745; /* verde */\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n\">\n  💾 Speichern\n</button>\n\n<button onclick=\"closeForm()\" style=\"\n  padding: 4px 10px;\n  font-size: 13px;\n  background-color: #f08080; /* rojo claro */\n  color: white;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n\">\n  ❌ Abbrechen\n</button>\n\n</div>\n\n<script>\n        let currentAction = \"insert\"; // Standardaktion\n\n        function prepareFormForInsert() {\n            currentAction = \"insert\";\n        clearFormFields();\n        openForm();\n}\n\n        function prepareFormForEdit() {\n  const selected = document.querySelector('.row-checkbox:checked');\n        if (!selected) {\n            alert(\"Bitte wählen Sie eine Zeile aus, um sie zu bearbeiten.\");\n        return;\n  }\n\n        currentAction = \"update\";\n        fillFormFromRow(selected);\n        openForm();\n}\n\n        function clearFormFields() {\n            document.getElementById(\"form-id\").value = \"\";\n        document.getElementById(\"form-modbus\").value = \"\";\n        document.getElementById(\"form-x\").value = \"\";\n        document.getElementById(\"form-y\").value = \"\";\n        document.getElementById(\"form-humidity\").value = \"\";\n}\n\n        function openForm() {\n            document.getElementById(\"form-container\").style.display = \"block\";\n}\n\n        function closeForm() {\n            document.getElementById(\"form-container\").style.display = \"none\";\n}\n\n        function submitForm() {\n  //const id = document.getElementById(\"form-id\").value.trim();\n\n  const data = {\n            id: document.getElementById(\"form-id\").value.trim(),\n        modBusId: document.getElementById(\"form-modbus\").value.trim(),\n        x: parseFloat(document.getElementById(\"form-x\").value),\n        y: parseFloat(document.getElementById(\"form-y\").value),\n        humidity: parseFloat(document.getElementById(\"form-humidity\").value),\n        watering: document.getElementById(\"form-watering\").value.trim(),\n        action: currentAction\n  };\n\n        uibuilder.send({_event: data });\n\n        alert(`Daten wurden zur ${currentAction === \"update\" ? \"Aktualisierung\" : \"Einfügung\"} an Node-RED gesendet.`);\n        closeForm();\n}\n\n        function fillFormFromRow(checkbox) {\n  //if (!checkbox.checked) return;\n\n  if (!checkbox.checked) {\n            //cerrar el formulario si se deselecciona la fila\n            closeForm();\n        return;\n  }\n\n        const row = checkbox.closest(\"tr\");\n        const cells = row.querySelectorAll(\"td\");\n\n        if (cells.length < 6) return;\n\n        document.getElementById(\"form-id\").value = cells[1].innerText.trim();\n        document.getElementById(\"form-modbus\").value = cells[2].innerText.trim();\n        document.getElementById(\"form-x\").value = cells[3].innerText.trim();\n        document.getElementById(\"form-y\").value = cells[4].innerText.trim();\n        document.getElementById(\"form-humidity\").value = cells[5].innerText.trim();\n        document.getElementById(\"form-watering\").value = row.cells[6].innerText; // NEU\n        document.getElementById(\"form-container\").style.display = \"block\";\n}\n\n\n\n\n        function handleSingleCheckboxSelection(clickedCheckbox) {\n  const allCheckboxes = document.querySelectorAll('.row-checkbox');\n\n  allCheckboxes.forEach(cb => {\n    const row = cb.closest(\"tr\");\n        const cells = row.querySelectorAll(\"td\");\n        const id = cells[1].innerText.trim();\n\n        if (cb === clickedCheckbox && cb.checked) {\n            cb.checked = true;\n        row.classList.add(\"highlight-row\");\n\n      // Quitar marco de todas las Kacheln\n      document.querySelectorAll('.default_tile').forEach(tile => {\n            tile.classList.remove(\"highlight-rectangle\");\n      });\n\n        // Resaltar la Kachel correspondiente\n        const kachel = document.getElementById(`tile${id}`);\n        if (kachel) {\n            kachel.classList.add(\"highlight-rectangle\");\n      }\n\n    } else {\n            cb.checked = false;\n        row.classList.remove(\"highlight-row\");\n\n        // Quitar marco de la Kachel correspondiente\n        const kachel = document.getElementById(`tile${id}`);\n      if (kachel) {\n        kachel.classList.remove(\"highlight-rectangle\");\n      }\n    }\n  });\n\n\n  // Llenar el formulario\n  fillFormFromRow(clickedCheckbox);\n}\n\n\nfunction handleTileClick(id) {\n  const rows = document.querySelectorAll('#table-body tr');\n\n  rows.forEach(row => {\n    const cells = row.querySelectorAll('td');\n    const checkbox = row.querySelector('.row-checkbox');\n\n    if (cells[1] && cells[1].innerText.trim() === String(id)) {\n        checkbox.click(); // Esto dispara el evento y mantiene el estado\n    }\n  });\n}\n\n\n\n\nfunction toggleAll(source) {\n  // Solo permitir selección múltiple si la acción actual es \"delete\"\n  if (currentAction !== \"delete\") {\n    alert(\"Mehrfachauswahl ist nur beim Löschen erlaubt.\");\n    source.checked = false; // desactiva el checkbox de cabecera\n    return;\n  }\n\n  const checkboxes = document.querySelectorAll('.row-checkbox');\n  checkboxes.forEach(cb => cb.checked = source.checked);\n}\n\n\n\nfunction deleteSelectedRow() {\n  currentAction = \"delete\"; \n  const selected = document.querySelector('.row-checkbox:checked');\n  if (!selected) {\n    alert(\"Bitte wählen Sie eine Zeile aus.\");\n    return;\n  }\n\n  const confirmed = confirm(\"Sind Sie sicher, dass Sie diese Zeile löschen möchten?\");\n  if (!confirmed) return;\n\n  const row = selected.closest(\"tr\");\n  const cells = row.querySelectorAll(\"td\");\n\n  const data = {\n    id: cells[1].innerText.trim(),\n    action: \"delete\"\n  };\n\n  uibuilder.send({ _event: data });\n\n  alert(\"Zeile wurde zur Löschung an Node-RED gesendet.\");\n}\n\n</script>","output":"str","x":500,"y":300,"wires":[["ebf632c26a8ffb0c"]]},{"id":"9c9da024b1068921","type":"change","z":"a2749ef0aa6beef9","name":"","rules":[{"t":"set","p":"payload","pt":"msg","to":"[{\"id\":\"9\",\"modBusId\":\"9\",\"x\":\"490\",\"y\":\"360\",\"humidity\":\"16\",\"watering\":\"Ja\"},{\"id\":\"8\",\"modBusId\":\"8\",\"x\":\"430\",\"y\":\"360\",\"humidity\":\"18\",\"watering\":\"Ja\"},{\"id\":\"7\",\"modBusId\":\"7\",\"x\":\"370\",\"y\":\"360\",\"humidity\":\"22\",\"watering\":\"Ja\"},{\"id\":\"6\",\"modBusId\":\"6\",\"x\":\"490\",\"y\":\"300\",\"humidity\":\"22\",\"watering\":\"Ja\"},{\"id\":\"5\",\"modBusId\":\"5\",\"x\":\"430\",\"y\":\"300\",\"humidity\":\"29\",\"watering\":\"Ja\"},{\"id\":\"4\",\"modBusId\":\"4\",\"x\":\"370\",\"y\":\"300\",\"humidity\":\"22\",\"watering\":\"Ja\"},{\"id\":\"3\",\"modBusId\":\"3\",\"x\":\"490\",\"y\":\"240\",\"humidity\":\"26\",\"watering\":\"Ja\"},{\"id\":\"2\",\"modBusId\":\"2\",\"x\":\"430\",\"y\":\"240\",\"humidity\":\"24\",\"watering\":\"Ja\"},{\"id\":\"1\",\"modBusId\":\"1\",\"x\":\"370\",\"y\":\"240\",\"humidity\":\"22\",\"watering\":\"Ja\"}]","tot":"json"}],"action":"","property":"","from":"","to":"","reg":false,"x":330,"y":140,"wires":[["3a94a9bc9ad8b897"]]},{"id":"d09f562a194d8b8d","type":"function","z":"a2749ef0aa6beef9","name":"delete msg","func":"const _event = msg._event;\nmsg = {};\nmsg._event = _event;\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":660,"wires":[["fb45653156626cbb"]]},{"id":"bd44bb4b8b46d711","type":"function","z":"a2749ef0aa6beef9","name":"compute tiles","func":"    let newPayload = [];\n\nif (msg._event != undefined) {\n    //let tileID = msg._actions.id;\n    //nur bei Button-Events haben wir eine konkrete Kachel\n\n    //if (msg._event.action == 'insert'\n    //    || msg._event.action == 'update'\n    //    || msg._event.action == 'delete') {\n    let tileEntry = {\n        id: msg._event.id,\n        modBusId: msg._event.modBusId,\n        x: msg._event.x,\n        y: msg._event.y,\n        humidity: msg._event.humidity\n    };\n    //}\n\n    switch (msg._event.action) {\n    \n        case 'insert':\n            // Añadir nuevo tile si no existe\n            const exists = msg.payload.some(obj => obj.id === tileEntry.id);\n            if (!exists) {\n                msg.payload.push(tileEntry);\n            }\n            break;\n\n        case 'update':\n            // Actualizar tile existente\n               newPayload = msg.payload.map( function (tile) {\n                if (tile.id == tileEntry.id) {\n                    tile.modBusId = tileEntry.modBusId;\n                    tile.x = tileEntry.x;\n                    tile.y = tileEntry.y;\n                    tile.humidity = tileEntry.humidity;\n                }\n                return tile;\n            });\n            msg.payload = newPayload;\n            break;\n\n        case 'delete':\n            newPayload = msg.payload.filter(obj => obj.id !== tileEntry.id);\n            msg.payload = newPayload;\n            break;\n        case 'compute':\n            //let newHumidity = 70; //TODO\n            // Actualizar tile existente\n               newPayload = msg.payload.map( function (tile) {\n\n                    tile.humidity = Math.floor(Math.random() * (100 - 1 + 1)) + 1;\n                    if( tile.humidity >= 70 ) {\n                        tile.is_humid = true;\n                        tile.watering = \"Nein\";\n                    }\n                    else {\n                        tile.is_humid = false;\n                        tile.watering = \"Ja\";\n                    }\n                return tile;\n            });\n            msg.payload = newPayload;\n            break;\n    }\n}\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":370,"y":400,"wires":[["7e8c9896538b7187","4e1ad11c02a63393"]]},{"id":"fb45653156626cbb","type":"function","z":"a2749ef0aa6beef9","name":