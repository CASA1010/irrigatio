   <td><input type=\"checkbox\" class=\"row-checkbox\" onclick=\"fillFormFromRow(this)\"></td>\n        <td>{{id}}</td>\n        <td>{{modBusId}}</td>\n        <td>{{x}}</td>\n        <td>{{y}}</td>\n        <td>{{humidity}}</td>\n      </tr>\n      {{/payload}}\n    </tbody>\n  </table>\n\n  <!-- Botones alineados a la derecha debajo de la tabla -->\n  <div style=\"display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;\">\n    <button onclick=\"prepareFormForInsert()\" style=\"\n      padding: 6px 12px;\n      font-size: 14px;\n      background-color: #007bff;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    \">\n      Zeile hinzufügen\n    </button>\n\n     <button onclick=\"prepareFormForEdit()\" style=\"\n    padding: 6px 12px;\n    font-size: 14px;\n    background-color: #ffc107;\n    color: black;\n    border: none;\n    border-radius: 4px;\n    cursor: pointer;\n  \">\n    Zeile bearbeiten\n  </button>\n\n    <button onclick=\"deleteSelectedRow()\" style=\"\n      padding: 6px 12px;\n      font-size: 14px;\n      background-color: #dc3545;\n      color: white;\n      border: none;\n      border-radius: 4px;\n      cursor: pointer;\n    \">\n      Zeile löschen\n    </button>\n  </div>\n</div>\n\n\n\n<!-- Formularbereich -->\n<div id=\"form-container\" style=\"display:none; margin-top: 20px; border: 1px solid #ccc; padding: 10px;\">\n  <h4>Zeilenformular</h4>\n  <label>Id: <input type=\"text\" id=\"form-id\"></label><br>\n  <label>ModBus-Adresse: <input type=\"text\" id=\"form-modbus\"></label><br>\n  <label>X-Position: <input type=\"number\" id=\"form-x\"></label><br>\n  <label>Y-Position: <input type=\"number\" id=\"form-y\"></label><br>\n  <label>Feuchtigkeit: <input type=\"number\" id=\"form-humidity\"></label><br><br>\n  <button onclick=\"submitForm()\">💾 Speichern</button>\n  <button onclick=\"closeForm()\">❌ Abbrechen</button>\n</div>\n\n<!-- Scripts -->\n<script>\n/*function openForm() {\n  document.getElementById(\"form-container\").style.display = \"block\";\n}\n\nfunction closeForm() {\n  document.getElementById(\"form-container\").style.display = \"none\";\n}\n\n\nfunction isExistingId(id) {\n  const rows = document.querySelectorAll(\"#table-body tr\");\n  for (let row of rows) {\n    const cells = row.querySelectorAll(\"td\");\n    if (cells[1].innerText.trim() === id) {\n      return true;\n    }\n  }\n  return false;\n}\n\n\n\n\n\n/*function submitForm() {\n  const data = {\n    id: document.getElementById(\"form-id\").value,\n    modBusId: document.getElementById(\"form-modbus\").value,\n    x: parseFloat(document.getElementById(\"form-x\").value),\n    y: parseFloat(document.getElementById(\"form-y\").value),\n    humidity: parseFloat(document.getElementById(\"form-humidity\").value)\n    //TODO: action = insert / update\n  };\n\n  uibuilder.send({ _actions: data });\n\n  alert(\"Daten wurden an Node-RED gesendet.\");\n  closeForm();\n} */\n\n/*function submitForm() {\n  const id = document.getElementById(\"form-id\").value.trim();\n  const action = isExistingId(id) ? \"update\" : \"insert\";\n\n  const data = {\n    id: id,\n    modBusId: document.getElementById(\"form-modbus\").value.trim(),\n    x: parseFloat(document.getElementById(\"form-x\").value),\n    y: parseFloat(document.getElementById(\"form-y\").value),\n    humidity: parseFloat(document.getElementById(\"form-humidity\").value),\n    action: action\n  };\n\n  uibuilder.send({ _actions: data });\n\n  alert(`Daten wurden zur ${action === \"update\" ? \"Aktualisierung\" : \"Einfügung\"} an Node-RED gesendet.`);\n  closeForm();\n}\n\nfunction fillFormFromRow(checkbox) {\n  if (!checkbox.checked) return;\n\n  const row = checkbox.closest(\"tr\");\n  const cells = row.querySelectorAll(\"td\");\n\n  if (cells.length < 6) return;\n\n  document.getElementById(\"form-id\").value = cells[1].innerText.trim();\n  document.getElementById(\"form-modbus\").value = cells[2].innerText.trim();\n  document.getElementById(\"form-x\").value = cells[3].innerText.trim();\n  document.getElementById(\"form-y\").value = cells[4].innerText.trim();\n  document.getElementById(\"form-humidity\").value = cells[5].innerText.trim();\n\n  openForm();\n}\n\nfunction toggleAll(source) {\n  const checkboxes = document.querySelectorAll('.row-checkbox');\n  checkboxes.forEach(cb => cb.checked = source.checked);\n}\n\nfunction deleteSelectedRow() {\n  const selected = document.querySelector('.row-checkbox:checked');\n  if (!selected) {\n    alert(\"Bitte wählen Sie eine Zeile aus.\");\n    return;\n  }\n\n  const confirmed = confirm(\"Sind Sie sicher, dass Sie diese Zeile löschen möchten?\");\n  if (!confirmed) return;\n\n  const row = selected.closest(\"tr\");\n  const cells = row.querySelectorAll(\"td\");\n\n  const data = {\n    id: cells[1].innerText.trim(),\n    action: \"delete\"\n  };\n\n  uibuilder.send({ _actions: data });\n\n  alert(\"Zeile wurde zur Löschung an Node-RED gesendet.\");\n  //row.remove(); // Opcional: eliminar visualmente\n}*/\n\n\nlet currentAction = \"insert\"; // Standardaktion\n\nfunction prepareFormForInsert() {\n  currentAction = \"insert\";\n  clearFormFields();\n  openForm();\n}\n\nfunction prepareFormForEdit() {\n  const selected = document.querySelector('.row-checkbox:checked');\n  if (!selected) {\n    alert(\"Bitte wählen Sie eine Zeile aus, um sie zu bearbeiten.\");\n    return;\n  }\n\n  currentAction = \"update\";\n  fillFormFromRow(selected);\n  openForm();\n}\n\nfunction clearFormFields() {\n  document.getElementById(\"form-id\").value = \"\";\n  document.getElementById(\"form-modbus\").value = \"\";\n  document.getElementById(\"form-x\").value = \"\";\n  document.getElementById(\"form-y\").value = \"\";\n  document.getElementById(\"form-humidity\").value = \"\";\n}\n\nfunction openForm() {\n  document.getElementById(\"form-container\").style.display = \"block\";\n}\n\nfunction closeForm() {\n  document.getElementById(\"form-container\").style.display = \"none\";\n}\n\nfunction submitForm() {\n  //const id = document.getElementById(\"form-id\").value.trim();\n\n  const data = {\n    id: document.getElementById(\"form-id\").value.trim(),\n    modBusId: document.getElementById(\"form-modbus\").value.trim(),\n    x: parseFloat(document.getElementById(\"form-x\").value),\n    y: parseFloat(document.getElementById(\"form-y\").value),\n    humidity: parseFloat(document.getElementById(\"form-humidity\").value),\n    action: currentAction\n  };\n\n  uibuilder.send({ _actions: data });\n\n  alert(`Daten wurden zur ${currentAction === \"update\" ? \"Aktualisierung\" : \"Einfügung\"} an Node-RED gesendet.`);\n  closeForm();\n}\n\nfunction fillFormFromRow(checkbox) {\n  if (!checkbox.checked) return;\n\n  const row = checkbox.closest(\"tr\");\n  const cells = row.querySelectorAll(\"td\");\n\n  if (cells.length < 6) return;\n\n  document.getElementById(\"form-id\").value = cells[1].innerText.trim();\n  document.getElementById(\"form-modbus\").value = cells[2].innerText.trim();\n  document.getElementById(\"form-x\").value = cells[3].innerText.trim();\n  document.getElementById(\"form-y\").value = cells[4].innerText.trim();\n  document.getElementById(\"form-humidity\").value = cells[5].innerText.trim();\n\n  //openForm();\n}\n\nfunction toggleAll(source) {\n  const checkboxes = document.querySelectorAll('.row-checkbox');\n  checkboxes.forEach(cb => cb.checked = source.checked);\n}\n\nfunction deleteSelectedRow() {\n  const selected = document.querySelector('.row-checkbox:checked');\n  if (!selected) {\n    alert(\"Bitte wählen Sie eine Zeile aus.\");\n    return;\n  }\n\n  const confirmed = confirm(\"Sind Sie sicher, dass Sie diese Zeile löschen möchten?\");\n  if (!confirmed) return;\n\n  const row = selected.closest(\"tr\");\n  const cells = row.querySelectorAll(\"td\");\n\n  const data = {\n    id: cells[1].innerText.trim(),\n    action: \"delete\"\n  };\n\n  uibuilder.send({ _actions: data });\n\n  alert(\"Zeile wurde zur Löschung an Node-RED gesendet.\");\n}\n</script>\n\n\n\n\n","output":"str","x":380,"y":100,"wires":[["ebf632c26a8ffb0c"]]},{"id":"9c9da024b1068921","type":"change","z":"a2749ef0aa6beef9","name":"","rules":[{"t":"set","p":"payload","pt":"msg","to":"[{\"id\":\"9\",\"modBusId\":\"9\",\"x\":\"490\",\"y\":\"360\",\"humidity\":\"16\"},{\"id\":\"8\",\"modBusId\":\"8\",\"x\":\"430\",\"y\":\"360\",\"humidity\":\"18\"},{\"id\":\"7\",\"modBusId\":\"7\",\"x\":\"370\",\"y\":\"360\",\"humidity\":\"22\"},{\"id\":\"6\",\"modBusId\":\"6\",\"x\":\"490\",\"y\":\"300\",\"humidity\":\"22\"},{\"id\":\"5\",\"modBusId\":\"5\",\"x\":\"430\",\"y\":\"300\",\"humidity\":\"29\"},{\"id\":\"4\",\"modBusId\":\"4\",\"x\":\"370\",\"y\":\"300\",\"humidity\":\"22\"},{\"id\":\"3\",\"modBusId\":\"3\",\"x\":\"490\",\"y\":\"240\",\"humidity\":\"26\"},{\"id\":\"2\",\"modBusId\":\"2\",\"x\":\"430\",\"y\":\"240\",\"humidity\":\"24\"},{\"id\":\"1\",\"modBusId\":\"1\",\"x\":\"370\",\"y\":\"240\",\"humidity\":\"22\"}]","tot":"json"}],"action":"","property":"","from":"","to":"","reg":false,"x":310,"y":60,"wires":[["3a94a9bc9ad8b897"]]},{"id":"d09f562a194d8b8d","type":"function","z":"a2749ef0aa6beef9","name":"Msg löschen","func":"const _actions = msg._actions;\nmsg = {};\nmsg._actions = _actions;\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":150,"y":340,"wires":[["fb45653156626cbb"]]},{"id":"bd44bb4b8b46d711","type":"function","z":"a2749ef0aa6beef9","name":"Tile-Actions","func":"/*if(msg._actions != undefined){\n    let tileID = msg._actions.id;\n    switch(msg._actions.action){\n        case 'insert':\n        //TODO\n        break;\n        case 'update':\n        //TODO\n        break;\n        case 'delete':\n        \n        \n        /*\n        let index = 0; //Position des zu löschenden Eintrags\n        for(let i = 0; i < msg.payload.length; i++){\n            if (msg.payload[i].id = tileID){\n                index = i;\n                break;\n            }\n        }\n\n        let payload_new = msg.payload.splice(index,1);\n        */\n\n\n           /* const newPayload = msg.payload.filter(obj => obj.id !== tileID);\n        msg.payload = newPayload;\n        break;\n    }\n}\n\nreturn msg;*/\n\n    let newPayload = [];\n\nif (msg._actions != undefined) {\n    let tileID = msg._actions.id;\n    let tileData = {\n        //id: msg._actions.id,\n        modBusId: msg._actions.modBusId,\n        x: msg._actions.x,\n        y: msg._actions.y,\n        humidity: msg._actions.humidity\n    };\n\n    switch (msg._actions.action) {\n    \n        case 'insert':\n            // Añadir nuevo tile si no existe\n            const exists = msg.payload.some(obj => obj.id === tileID);\n            if (!exists) {\n                msg.payload.push(tileData);\n            }\n            break;\n\n        case 'update':\n            // Actualizar tile existente\n               newPayload = msg.payload.map( function (tile) {\n                if (tile.id == tileID) {\n                    tile.modBusId = tileData.modBusId;\n                    tile.x = tileData.x;\n                    tile.y = tileData.y;\n                    tile.humidity = tileData.humidity;\n                }\n                return tile;\n            });\n            msg.payload = newPayload;\n            break;\n\n        case 'delete':\n            newPayload = msg.payload.filter(obj => obj.id !== tileID);\n            msg.payload = newPayload;\n            break;\n    }\n}\n\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":330,"y":200,"wires":[["7e8c9896538b7187","f6144f0fbc0a276f"]]},{"id":"fb45653156626cbb","type":"function","z":"a2749ef0aa6beef9","name":"flow.get","func":"msg.payload = flow.get(\"payload\");\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":80,"y":200,"wires":[["bd44bb4b8b46d711","99e483255c584f04"]]},{"id":"7e8c9896538b7187","type":"function","